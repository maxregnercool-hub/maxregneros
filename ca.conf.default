# MaxRegnerOS configuration
# takeover level: shell (replace launcher) | display (own the framebuffer) | off
MRCA_TAKEOVER=display
# runtime: shell (no compiler needed) | native (needs mrca-client) | both
MRCA_MODE=shell
# cloud avatar (optional - leave blank for fully local)
MRCA_SERVER_HOST=
MRCA_SERVER_PORT=8080
MRCA_AUTH_TOKEN=
MRCA_DEVICE_ID=
# display
MRCA_TARGET_FPS=60
MRCA_CODEC=raw565
